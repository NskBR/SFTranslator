{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFTranslator",
  "version": "0.1.0",
  "identifier": "com.uat.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "SFTranslator", "width": 1171, "height": 653, "minWidth": 1171, "minHeight": 653, "resizable": true, "decorations": false, "transparent": false, "backgroundColor": "#0b0d12", "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": { "resources/runtimes/": "runtimes/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
